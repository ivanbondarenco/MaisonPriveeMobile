{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.maisonpriveeatelier.com/api",
        "EXPO_PUBLIC_SITE_URL": "https://maisonpriveeatelier.com"
      },
      "ios": {
        "resourceClass": "default"
      },
      "channel": "base"
    },
    "development": {
      "extends": "base",
      "channel": "development",
      "environment": "development",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
