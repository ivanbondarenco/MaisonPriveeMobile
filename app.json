{
  "expo": {
    "name": "Maison Privée",
    "slug": "MaisonPriveeMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "maisonprivee",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9F8F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maisonpriveeatelier.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Maison Privée Atelier needs access to your photos so you can attach your bank transfer receipt."
        }
      ]
    ]
  }
}
